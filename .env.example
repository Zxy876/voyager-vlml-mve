# 复制为 mve/.env 后填入自己的值。.env 已在 .gitignore 中，不会被提交。
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

# ---- 开关（都可不填，默认见 README 的开关表）----
# 主循环是否走代码化取证路径：1 开 / 0 关（默认 0）
MVE_ACTION_CODE=1
# 图谱各层：1 开 / 0 关
MVE_GRAPH=1
MVE_GRAPH_SEED=1
MVE_GRAPH_INSIGHT=1
MVE_GRAPH_SECTION=1
MVE_GRAPH_STAGE=1
MVE_GRAPH_RECIPE=1
# 调试
MVE_DEBUG_PROMPT=0
MVE_ASSERT=1
